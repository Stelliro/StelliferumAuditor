# =============================================================================
# Stelliferum Auditor — gitignore
# Runtime server dumps, build trees, secrets, and caches stay local.
# =============================================================================

# --- Build / CMake ---
build/
build-alpine/
build-linux*/
cmake_build/
out/
dist/
# Local QA artifacts may contain hostnames / live dumps — keep bulk local
qa/**/*.log
qa/**/*session*
qa/**/_tmp*
qa/**/baseline/
qa/**/*-verify/
qa/**/pulled/
qa/**/*.xml
qa/**/*.json
config/_qa_bak/

# --- Release packaging (local) ---
*.zip
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
*.cmake
*.vcxproj
*.vcxproj.filters
*.sln
.vs/
.cmake/
compile_commands.json

# --- Compiled artifacts ---
bin/
lib/
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.so
*.dylib
*.pdb
*.ilk
*.exp

# --- FetchContent / vendored build deps ---
_deps/

# --- Portable third-party binaries (keep README) ---
libs/**
!libs/README.md

# --- Server sync & mission data (regenerated / local only) ---
downloaded_mods/
downloaded_mods%2F/
downloaded_loot/
base/
Serverfiles/
backups/
output/
output_backups/
mods/**/*.pbo
mods/**/*.bisign
mods/**/*.bikey

# --- Secrets & local credentials (NEVER commit) ---
# Live FTP/SFTP credentials written by the GUI
config/ftp.ini
**/ftp.ini
!**/ftp.ini.example
!config/ftp.ini.example
# Login field diagnostic dump (--ftp-export-login) — contains real secrets
config/ftp.login_export.txt
**/ftp.login_export.txt
config/known_hosts

# Live server path overrides (host-specific roots, mission paths)
config/server_paths.ini
**/server_paths.ini
!**/server_paths.ini.example
!config/server_paths.ini.example

# Generic secret / credential filenames
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.kdbx
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_dsa
id_ecdsa
*.ppk
.netrc
**/*credentials*
**/*secrets*
**/secrets.*
**/credentials.*
auth.ini
secrets.ini
credentials.ini

# WinSCP session / generated transfer scripts (may embed host/user)
winscp.ini
WinSCP.ini
**/winscp.ini
winscp.log
winscp_script.txt
winscp_*.txt
*.WinSCPextension.tmp

# --- Runtime caches (regenerated) ---
config/audit_index.csv
config/file_cache.csv
config/web_cache/
.phoenix/
.TEMP/
imgui.ini

# --- Logs & crash dumps ---
*.log
auditor_crash_log.txt
*.stackdump
core
core.*

# --- Editor / OS ---
.vscode/
.idea/
*.user
*.suo
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride
desktop.ini

# --- Backups & scratch ---
*.bak
*.tmp
*.old
*.orig
*~
.gitkeep

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/

# --- Optional AI / session indexes (local) ---
CODEBASE_INDEX.md
.claude/
.cursor/

# Local credential backups
config/ftp.ini.bak*
config/*.credentials
config/*secret*

